# 复制为 .env 后填入。.env 已在 .gitignore 中，不会入库。
#
# 任选一家 OpenAI 兼容端点。HAKO_MODEL / HAKO_BASE_URL 若留空，
# 会根据填了哪个 KEY 自动推断（见 hako/config.py）。

# DeepSeek
DEEPSEEK_API_KEY=

# 阿里云百炼（Qwen）
DASHSCOPE_API_KEY=

# 智谱 GLM
ZHIPU_API_KEY=

# 显式覆盖（可选）
# HAKO_MODEL=deepseek-chat
# HAKO_BASE_URL=https://api.deepseek.com/v1

# 运行参数（可选）
# HAKO_MAX_STEPS=40
# HAKO_CONTEXT_LIMIT=65536
