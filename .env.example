# 复制为 .env 后填入。.env 已在 .gitignore 中，不会进入仓库。

# 通用 OpenAI-compatible 接入（推荐）
# 适用于 OpenAI，以及灵眸等可路由 GPT / Claude 的兼容网关。
# 三项必须同时填写；Web 会展示 HAKO_MODEL 的真实值，不保存密钥。
HAKO_API_KEY=
HAKO_BASE_URL=
HAKO_MODEL=

# 下面是旧的提供商快捷配置。若未填写 HAKO_API_KEY，可任选一家；
# 不要同时填写多项，以免选择结果含糊。

# 硅基流动（推荐）
# 默认端点：https://api.siliconflow.cn/v1
# 默认模型：deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_API_KEY=

# DeepSeek 官方
# 默认模型：deepseek-v4-flash
DEEPSEEK_API_KEY=

# 阿里云百炼（Qwen）
DASHSCOPE_API_KEY=

# 智谱 GLM
ZHIPU_API_KEY=

# 使用提供商快捷配置时，可显式覆盖自动推断结果
# HAKO_MODEL=deepseek-ai/DeepSeek-V4-Flash
# HAKO_BASE_URL=https://api.siliconflow.cn/v1

# 运行参数（可选）
# HAKO_MAX_STEPS=40
# HAKO_CONTEXT_LIMIT=1000000
# HAKO_MAX_OUTPUT_TOKENS=4096
# 硅基流动默认 false；复杂任务可显式改为 true
# HAKO_ENABLE_THINKING=false
# 只读 subagent 默认关闭；开启后每个主任务最多委派一次
# HAKO_ENABLE_SUBAGENT=false
# HAKO_SUBAGENT_MAX_STEPS=6

# 单 Run 轻量上下文压缩（可选，默认关闭）
# 仅压缩下一次模型请求的 Working Memory 视图；完整事件与消息审计历史不变。
# HAKO_COMPACTION_ENABLED=false
# HAKO_COMPACTION_THRESHOLD=0.70
# HAKO_COMPACTION_KEEP_RECENT_MESSAGES=12
# 留空时使用确定性结构化摘要；填写后使用同一 API 端点上的轻量模型增强软语义。
# HAKO_COMPACTION_MODEL=
# HAKO_COMPACTION_TIMEOUT_SECONDS=20

# Repository Experience Memory（可选）
# 默认开启依赖为零的确定性检索；模型只会在需要复用既往工程经验时主动调用。
# HAKO_REPOSITORY_MEMORY_ENABLED=true
# 默认 hash 不下载模型；本机已安装 sentence-transformers 时可改为 sentence_transformer。
# HAKO_MEMORY_EMBEDDING_PROVIDER=hash
# HAKO_MEMORY_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 三因子评分：相关性、重要度、时间衰减。
# HAKO_MEMORY_RELEVANCE_WEIGHT=0.7
# HAKO_MEMORY_IMPORTANCE_WEIGHT=0.2
# HAKO_MEMORY_RECENCY_WEIGHT=0.1
# HAKO_MEMORY_RECENCY_LAMBDA=0.01
# HAKO_MEMORY_TOP_K=6
# HAKO_MEMORY_DENSE_BACKUP_K=4
# HAKO_MEMORY_RERANK_TOP_K=4
# 可选轻量模型重排，默认关闭以避免增加请求延迟和费用。
# HAKO_MEMORY_RERANK_ENABLED=false
# HAKO_MEMORY_RERANK_MODEL=
# HAKO_MEMORY_RERANK_TIMEOUT_SECONDS=20
