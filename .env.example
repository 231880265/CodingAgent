# 复制为 .env 后填入。.env 已在 .gitignore 中，不会进入仓库。

# 通用 OpenAI-compatible 接入（推荐）
# 适用于 OpenAI，以及灵眸等可路由 GPT / Claude 的兼容网关。
# 三项必须同时填写；Web 会展示 HAKO_MODEL 的真实值，不保存密钥。
HAKO_API_KEY=
HAKO_BASE_URL=
HAKO_MODEL=

# 下面是旧的提供商快捷配置。若未填写 HAKO_API_KEY，可任选一家；
# 不要同时填写多项，以免选择结果含糊。

# 硅基流动（推荐）
# 默认端点：https://api.siliconflow.cn/v1
# 默认模型：deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_API_KEY=

# DeepSeek 官方
# 默认模型：deepseek-v4-flash
DEEPSEEK_API_KEY=

# 阿里云百炼（Qwen）
DASHSCOPE_API_KEY=

# 智谱 GLM
ZHIPU_API_KEY=

# 使用提供商快捷配置时，可显式覆盖自动推断结果
# HAKO_MODEL=deepseek-ai/DeepSeek-V4-Flash
# HAKO_BASE_URL=https://api.siliconflow.cn/v1

# 运行参数（可选）
# HAKO_MAX_STEPS=40
# HAKO_CONTEXT_LIMIT=1000000
# HAKO_MAX_OUTPUT_TOKENS=4096
# 硅基流动默认 false；复杂任务可显式改为 true
# HAKO_ENABLE_THINKING=false
# 只读 subagent 默认关闭；开启后每个主任务最多委派一次
# HAKO_ENABLE_SUBAGENT=false
# HAKO_SUBAGENT_MAX_STEPS=6
